  "cards": [
    {
      "dot": "cyan",
      "title": "Request pipeline (src/start.ts)",
      "items": [
        "Request middleware order: requestContext -> locale (PARAGLIDE_LOCALE cookie, then Accept-Language) -> maintenance -> CSRF -> security headers",
        "Function middleware captures server-fn errors and reports them",
        "Routes import only *.functions.ts; createServerFn bodies become RPC stubs in the client bundle"
      ]
    },
    {
      "dot": "emerald",
      "title": "Budgets",
      "items": [
        "Spend = expenses only (amount_minor < 0), parent budgets roll up subcategories, per currency, per UTC month",
        "checkBudgetLimit: free plan 3 budgets (BILLING_FREE_MAX_BUDGETS), Pro unlimited"
      ]
    },
    {
      "dot": "amber",
      "title": "Budget alerts",
      "items": [
        "Scheduled fire-and-forget after mutations in transactions, imports, receipts and budgets functions",
        "Hourly sweep (runBudgetAlertSweep) also retries failed sends; never armed in TEST_MODE",
        "budget_alerts unique (budget_id, month): at most one email per budget per month"
      ]
    },
    {
      "dot": "violet",
      "title": "Receipt scan and externals",
      "items": [
        "scanReceipt stores images via storage.ts, then calls ai.ts extractReceiptItems",
        "AI provider: Gemini OpenAI-compatible endpoint, or OpenRouter / llama.cpp",
        "Email provider: console (dev), test (E2E) or Resend; Sentry only when SENTRY_DSN is set"
      ]
    }
  ]
